===== Loading modules =====
===== Compiling =====
rm -f *.o powermethod_rows
mpicc -c -O3  powermethod_rows.c
mpicc -c -O3  walltime.c
mpicc -lm  powermethod_rows.o walltime.o -o powermethod_rows
