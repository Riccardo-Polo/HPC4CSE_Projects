\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Approximate solution of the Poisson problem \(-\Delta u = 20\) in \(\Omega =(0,1)^2\), with homogeneous Dirichlet boundary conditions on \(\partial \Omega \). The solution is zero on the boundary and positive in the interior, with a maximum close to the centre of the domain, as expected from the symmetry of the problem and the positivity of the source term.}}{22}{figure.caption.21}\protected@file@percent }
\newlabel{fig:poisson_solution_visualization}{{19}{22}{Approximate solution of the Poisson problem \(-\Delta u = 20\) in \(\Omega =(0,1)^2\), with homogeneous Dirichlet boundary conditions on \(\partial \Omega \). The solution is zero on the boundary and positive in the interior, with a maximum close to the centre of the domain, as expected from the symmetry of the problem and the positivity of the source term}{figure.caption.21}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}Strong Scaling Analysis}{22}{subsection.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Strong scaling of the PETSc two-dimensional Poisson solver. The plot reports the median total time to solution for the grid resolutions \(n=512\) and \(n=1024\). The global problem size is fixed while the number of MPI processes, and therefore the number of nodes, is increased.}}{23}{figure.caption.22}\protected@file@percent }
\newlabel{fig:strong_scaling_total_time}{{20}{23}{Strong scaling of the PETSc two-dimensional Poisson solver. The plot reports the median total time to solution for the grid resolutions \(n=512\) and \(n=1024\). The global problem size is fixed while the number of MPI processes, and therefore the number of nodes, is increased}{figure.caption.22}{}}
\BKM@entry{id=14,dest={73756273656374696F6E2E322E35},srcline={1937}}{5C3337365C3337375C303030555C303030735C303030655C3030305C3034305C3030306F5C303030665C3030305C3034305C3030304C5C3030304C5C3030304D5C30303073}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Strong scaling of the PETSc solver phase. The plot reports the median time spent inside \texttt  {KSPSolve}. Compared with the total runtime, this isolates the performance of the Krylov solver and preconditioner from setup and output costs.}}{24}{figure.caption.23}\protected@file@percent }
\newlabel{fig:strong_scaling_solve_time}{{21}{24}{Strong scaling of the PETSc solver phase. The plot reports the median time spent inside \texttt {KSPSolve}. Compared with the total runtime, this isolates the performance of the Krylov solver and preconditioner from setup and output costs}{figure.caption.23}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}Use of LLMs}{24}{subsection.2.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Parallel efficiency based on the median total time to solution. The efficiency is computed as \(E_p = T_1/(pT_p)\). The decrease in efficiency at larger process counts reflects the increasing relative importance of communication and parallel overheads in the strong scaling regime.}}{25}{figure.caption.24}\protected@file@percent }
\newlabel{fig:strong_scaling_efficiency}{{22}{25}{Parallel efficiency based on the median total time to solution. The efficiency is computed as \(E_p = T_1/(pT_p)\). The decrease in efficiency at larger process counts reflects the increasing relative importance of communication and parallel overheads in the strong scaling regime}{figure.caption.24}{}}
